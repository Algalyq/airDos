POSTGRES_USER=airdos_user
POSTGRES_PASSWORD=airdos_password
POSTGRES_DB=airdos_db
POSTGRES_HOST=airdos-db
POSTGRES_PORT=5432

DATABASE_URL=postgresql+asyncpg://airdos_user:airdos_password@airdos-db:5432/airdos_db

SECRET_KEY=change-me-to-super-secret-key-at-least-32-characters-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=your-email@example.com
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_STARTTLS=True
MAIL_SSL_TLS=False

# For local MailHog testing use:
# MAIL_SERVER=airdos-mailhog
# MAIL_PORT=1025
# MAIL_USERNAME=airdos
# MAIL_PASSWORD=airdos
# MAIL_FROM=noreply@airdos.example.com
# MAIL_STARTTLS=false
# MAIL_SSL_TLS=false
# MAILHOG_ENABLED=true

RESEND_API_KEY=re_YOUR_RESEND_API_KEY
MAIL_FROM=onboarding@resend.dev

MINIO_ENDPOINT=airdos-minio:9000
MINIO_ROOT_USER=airdos_minio
MINIO_ROOT_PASSWORD=airdos_minio_secret
MINIO_BUCKET=airdos-documents
MINIO_SECURE=false
